# UnionLedger Environment Configuration
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=8080
NODE_ENV=production

# Blockchain RPC Providers
INFURA_KEY=your_infura_project_id_here
ALCHEMY_KEY=your_alchemy_api_key_here

# Payment Processing
FLW_SECRET_KEY=your_flutterwave_secret_key_here

# Alert Configuration (Optional)
SLACK_WEBHOOK_URL=your_slack_webhook_url_here

# Trading Configuration (Optional)
TRADING_API_KEY=your_trading_api_key_here
